{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Codex Taskboard 后台启动器与本地 sidecar",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/codex-taskboard-sidecar",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        { "name": "binaries/codex-taskboard-sidecar", "sidecar": true }
      ]
    }
  ]
}
